#!/bin/sh
# Self-extracting hashsuite archive. Usage: sh hashsuite-v2.shar [destination]
set -eu
DEST=${1:-hashsuite}
mkdir -p "$DEST"
TMP=${TMPDIR:-/tmp}/hashsuite-archive-$$.tar.gz
trap 'rm -f "$TMP"' EXIT HUP INT TERM
base64 -d > "$TMP" <<'HASH_SUITE_ARCHIVE_EOF'
