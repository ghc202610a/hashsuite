#!/bin/sh
# Self-extracting shell archive: parallel SHA-256/SHA-512 utilities
set -eu
DEST=${1:-hashsuite}
mkdir -p "$DEST"
cat > "$DEST/hashcore.py" <<'__HASH_SUITE_HASHCORE_PY_EOF__'
#!/usr/bin/env python3
"""Shared streaming hash engine for hashfiles.py and hashcheck.py."""

import hashlib
import os


def _new_hashers(algorithms):
    return {name: hashlib.new(name) for name in algorithms}


def _advise(fd, enabled=True):
    """Best-effort sequential/no-reuse advice; advice failures are non-fatal."""
    if not enabled or not hasattr(os, "posix_fadvise"):
        return
    for attr in ("POSIX_FADV_SEQUENTIAL", "POSIX_FADV_NOREUSE"):
        advice = getattr(os, attr, None)
        if advice is not None:
            try:
                os.posix_fadvise(fd, 0, 0, advice)
            except OSError:
                pass


def hash_stream(stream, algorithms=("sha256", "sha512"), chunk_size=8 * 1024 * 1024):
    """Hash a readable binary stream once; return {algorithm: digest_bytes}."""
    hashers = _new_hashers(algorithms)
    while True:
        chunk = stream.read(chunk_size)
        if not chunk:
            break
        for hasher in hashers.values():
            hasher.update(chunk)
    return {name: hasher.digest() for name, hasher in hashers.items()}


def hash_file(filename, algorithms=("sha256", "sha512"),
              chunk_size=8 * 1024 * 1024, advise=True):
    """Hash a file once; return {algorithm: digest_bytes}."""
    with open(filename, "rb") as stream:
        _advise(stream.fileno(), advise)
        return hash_stream(stream, algorithms, chunk_size)
__HASH_SUITE_HASHCORE_PY_EOF__
cat > "$DEST/hashfiles.py" <<'__HASH_SUITE_HASHFILES_PY_EOF__'
#!/usr/bin/env python3
"""Generate GNU sha256sum/sha512sum-compatible checksum manifests."""

import argparse
import concurrent.futures
import os
import sys
import threading

from hashcore import hash_file


def checksum_line(digest, filename):
    """GNU checksum binary-mode record, including escaped filenames."""
    name = os.fsencode(filename)
    escaped = b"\\" in name or b"\n" in name
    if escaped:
        name = name.replace(b"\\", b"\\\\").replace(b"\n", b"\\n")
    return (b"\\" if escaped else b"") + digest.hex().encode("ascii") + b" *" + name + b"\n"


def same_file(path1, path2):
    if os.path.abspath(path1) == os.path.abspath(path2):
        return True
    try:
        return os.path.samefile(path1, path2)
    except (OSError, ValueError):
        return os.path.realpath(path1) == os.path.realpath(path2)


def main():
    parser = argparse.ArgumentParser(description="Parallel GNU-compatible SHA-256/SHA-512 checksum generator.")
    parser.add_argument("-j", "--jobs", type=int, default=os.cpu_count() or 1,
                        help="maximum concurrent file workers (default: CPU count)")
    parser.add_argument("--chunk-mib", type=int, default=8, metavar="N",
                        help="read buffer size in MiB (default: 8)")
    parser.add_argument("-o256", "--output256", default="SHA256SUMS", metavar="FILE")
    parser.add_argument("-o512", "--output512", default="SHA512SUMS", metavar="FILE")
    parser.add_argument("--truncate", action="store_true", help="truncate rather than append")
    parser.add_argument("--no-advice", action="store_true", help="disable Linux sequential/NOREUSE advice")
    parser.add_argument("files", nargs="+", metavar="FILE")
    args = parser.parse_args()
    if args.jobs < 1 or args.chunk_mib < 1:
        parser.error("--jobs and --chunk-mib must be positive")
    for out in (args.output256, args.output512):
        for filename in args.files:
            if same_file(out, filename):
                parser.error(f"output file is also an input file: {filename}")
    if same_file(args.output256, args.output512):
        parser.error("SHA-256 and SHA-512 output files must differ")

    mode = "wb" if args.truncate else "ab"
    try:
        out256 = open(args.output256, mode)
        try:
            out512 = open(args.output512, mode)
        except OSError:
            out256.close()
            raise
    except OSError as exc:
        parser.error(f"cannot open output file: {exc}")

    errors = 0
    lock = threading.Lock()
    chunk_size = args.chunk_mib * 1024 * 1024
    try:
        with out256, out512:
            with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as pool:
                futures = {pool.submit(hash_file, name, ("sha256", "sha512"),
                                       chunk_size, not args.no_advice): name
                           for name in args.files}
                for future in concurrent.futures.as_completed(futures):
                    filename = futures[future]
                    try:
                        digests = future.result()
                    except OSError as exc:
                        errors += 1
                        print(f"hashfiles.py: {filename}: {exc}", file=sys.stderr)
                        continue
                    line256 = checksum_line(digests["sha256"], filename)
                    line512 = checksum_line(digests["sha512"], filename)
                    with lock:
                        out256.write(line256)
                        out512.write(line512)
                    print(f"OK: {filename}", file=sys.stderr)
    except OSError as exc:
        print(f"hashfiles.py: output error: {exc}", file=sys.stderr)
        return 1
    print(f"Completed: {len(args.files) - errors} successful, {errors} failed.", file=sys.stderr)
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
__HASH_SUITE_HASHFILES_PY_EOF__
cat > "$DEST/hashcheck.py" <<'__HASH_SUITE_HASHCHECK_PY_EOF__'
#!/usr/bin/env python3
"""Parallel verifier for GNU-compatible SHA-256/SHA-512 checksum manifests."""

import argparse
import concurrent.futures
import os
import re
import sys

from hashcore import hash_file, hash_stream

_HEX = re.compile(br"^[0-9a-fA-F]+$")


def decode_filename(name, escaped):
    if not escaped:
        return name
    result = bytearray()
    i = 0
    while i < len(name):
        byte = name[i]
        if byte != 0x5c:
            result.append(byte)
            i += 1
            continue
        if i + 1 >= len(name):
            raise ValueError("trailing backslash in escaped filename")
        nxt = name[i + 1]
        if nxt == ord("\\"):
            result.append(ord("\\"))
        elif nxt == ord("n"):
            result.append(ord("\n"))
        else:
            raise ValueError("invalid escape in filename")
        i += 2
    return bytes(result)


def parse_manifest(data, manifest_name, selected):
    """Return (records, malformed_count); records retain manifest order."""
    records = []
    malformed = 0
    for line_number, line in enumerate(data.split(b"\n"), 1):
        if not line:
            continue
        escaped = line.startswith(b"\\")
        body = line[1:] if escaped else line
        # SHA-256 is tested first: a long SHA-256 filename can itself
        # contain a space at byte offset 128.
        if len(body) >= 67 and body[64:66] in (b"  ", b" *"):
            digest = body[:64]
            separator = body[64:66]
            filename = body[66:]
        elif len(body) >= 131 and body[128:130] in (b"  ", b" *"):
            digest = body[:128]
            separator = body[128:130]
            filename = body[130:]
        else:
            malformed += 1
            print(f"hashcheck.py: {manifest_name}:{line_number}: improperly formatted checksum line", file=sys.stderr)
            continue
        if len(digest) not in (64, 128) or not _HEX.fullmatch(digest) or separator not in (b"  ", b" *") or not filename:
            malformed += 1
            print(f"hashcheck.py: {manifest_name}:{line_number}: improperly formatted checksum line", file=sys.stderr)
            continue
        algorithm = "sha256" if len(digest) == 64 else "sha512"
        try:
            filename = decode_filename(filename, escaped)
        except ValueError as exc:
            malformed += 1
            print(f"hashcheck.py: {manifest_name}:{line_number}: {exc}", file=sys.stderr)
            continue
        if algorithm not in selected:
            continue
        records.append({
            "algorithm": algorithm,
            "expected": bytes.fromhex(digest.decode("ascii")),
            "filename": filename,
            "manifest": manifest_name,
            "line": line_number,
        })
    return records, malformed


def display_name(name):
    escaped = b"\\" in name or b"\n" in name
    if escaped:
        name = name.replace(b"\\", b"\\\\").replace(b"\n", b"\\n")
        return b"\\" + name
    return name


def main():
    parser = argparse.ArgumentParser(description="Parallel GNU-compatible SHA-256/SHA-512 checksum verifier.")
    parser.add_argument("-j", "--jobs", type=int, default=os.cpu_count() or 1,
                        help="maximum concurrent workers (default: CPU count)")
    parser.add_argument("--chunk-mib", type=int, default=8, metavar="N",
                        help="read buffer size in MiB (default: 8)")
    parser.add_argument("--no-advice", action="store_true", help="disable Linux sequential/NOREUSE advice")
    parser.add_argument("--sha256", action="store_true", help="verify SHA-256 records only (default: infer)")
    parser.add_argument("--sha512", action="store_true", help="verify SHA-512 records only (default: infer)")
    parser.add_argument("manifests", nargs="+", metavar="MANIFEST",
                        help="checksum manifest(s); use - for standard input")
    args = parser.parse_args()
    if args.jobs < 1 or args.chunk_mib < 1:
        parser.error("--jobs and --chunk-mib must be positive")
    if args.manifests.count("-") > 1:
        parser.error("standard input may be used for only one manifest")

    # No switches means infer and verify all recognized algorithms.
    selected = {"sha256", "sha512"}
    if args.sha256 or args.sha512:
        selected = set()
        if args.sha256:
            selected.add("sha256")
        if args.sha512:
            selected.add("sha512")

    all_records = []
    malformed = 0
    try:
        for manifest in args.manifests:
            if manifest == "-":
                data = sys.stdin.buffer.read()
            else:
                with open(manifest, "rb") as stream:
                    data = stream.read()
            records, bad = parse_manifest(data, manifest, selected)
            all_records.extend(records)
            malformed += bad
    except OSError as exc:
        print(f"hashcheck.py: {exc}", file=sys.stderr)
        return 1

    if any(record["filename"] == b"-" for record in all_records) and "-" in args.manifests:
        print("hashcheck.py: cannot use standard input for both a manifest and a checked file", file=sys.stderr)
        return 1

    if not all_records:
        print("hashcheck.py: no checksum records selected", file=sys.stderr)
        return 1

    # Group records by exact filesystem-byte filename. Each distinct file is read once.
    work = {}
    for index, record in enumerate(all_records):
        key = record["filename"]
        item = work.setdefault(key, {"algorithms": set(), "records": []})
        item["algorithms"].add(record["algorithm"])
        item["records"].append(index)

    chunk_size = args.chunk_mib * 1024 * 1024
    results = {}
    future_keys = {}
    failures = 0
    mismatches = 0
    cursor = 0

    def emit_ready():
        nonlocal cursor, failures, mismatches
        while cursor < len(all_records):
            record = all_records[cursor]
            key = record["filename"]
            if key not in results:
                break
            result, error = results[key]
            name = display_name(key)
            if error is not None:
                status = b"FAILED open or read"
                failures += 1
            elif result[record["algorithm"]] == record["expected"]:
                status = b"OK"
            else:
                status = b"FAILED"
                mismatches += 1
            sys.stdout.buffer.write(name + b": " + status + b"\n")
            cursor += 1

    try:
        with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as pool:
            # Queue stdin first so it can be consumed once while file workers run.
            for filename, item in work.items():
                algorithms = tuple(sorted(item["algorithms"]))
                if filename == b"-":
                    future = pool.submit(hash_stream, sys.stdin.buffer, algorithms, chunk_size)
                else:
                    path = os.fsdecode(filename)
                    future = pool.submit(hash_file, path, algorithms, chunk_size, not args.no_advice)
                future_keys[future] = filename

            for future in concurrent.futures.as_completed(future_keys):
                key = future_keys[future]
                try:
                    results[key] = (future.result(), None)
                except OSError as exc:
                    results[key] = (None, exc)
                    print(f"hashcheck.py: {os.fsdecode(key)}: {exc}", file=sys.stderr)
                emit_ready()
    except OSError as exc:
        print(f"hashcheck.py: output or input error: {exc}", file=sys.stderr)
        return 1

    sys.stdout.buffer.flush()
    total_failed = failures + mismatches + malformed
    if mismatches:
        noun = "checksum" if mismatches == 1 else "checksums"
        print(f"hashcheck.py: WARNING: {mismatches} computed {noun} did NOT match", file=sys.stderr)
    if malformed:
        noun = "line is" if malformed == 1 else "lines are"
        print(f"hashcheck.py: WARNING: {malformed} {noun} improperly formatted", file=sys.stderr)
    return 1 if total_failed else 0


if __name__ == "__main__":
    sys.exit(main())
__HASH_SUITE_HASHCHECK_PY_EOF__
cat > "$DEST/README.txt" <<'__HASH_SUITE_README_TXT_EOF__'
Parallel SHA-256 / SHA-512 utilities
====================================

Contents
--------
hashcore.py   Shared one-pass hashing engine.
hashfiles.py  Parallel manifest generator.
hashcheck.py  Parallel GNU-compatible manifest verifier.

Requirements
------------
Python 3.8+; standard library only.

Install
-------
Extract the shar archive, then run the scripts from the extracted directory
(or put all three files in the same directory). The scripts are executable.

Generate both manifests (append by default):
    ./hashfiles.py FILE [FILE ...]

Start fresh:
    ./hashfiles.py --truncate FILE [FILE ...]

Choose worker count and read chunk size:
    ./hashfiles.py -j 16 --chunk-mib 32 FILE [FILE ...]

Custom manifest names:
    ./hashfiles.py -o256 SHA256SUMS -o512 SHA512SUMS FILE [FILE ...]

Verify one or more manifests; algorithms are inferred from digest lengths:
    ./hashcheck.py SHA256SUMS SHA512SUMS

Filter a mixed manifest:
    ./hashcheck.py --sha256 mixed.sums
    ./hashcheck.py --sha512 mixed.sums

Read a manifest from stdin:
    cat SHA256SUMS | ./hashcheck.py -

Verify stdin as a checked file (manifest must come from a file):
    cat FILE | ./hashcheck.py stdin-checksums.sums

Both utilities accept -j N, --chunk-mib N, and --no-advice.

Design notes
------------
* Each file is read once, with all required hash algorithms updated from the
  same chunk buffer.
* Files are processed concurrently with ThreadPoolExecutor.
* The checker deduplicates identical filename byte strings across manifests.
* Checker output follows manifest argument order and record order, regardless
  of worker completion order.
* A filename of '-' in a checksum record refers to standard input. Standard
  input is consumed once and hashed with all algorithms needed for that record.
* A manifest argument of '-' means the manifest itself comes from stdin; it
  cannot simultaneously be used as the checked-file stream.
* GNU checksum filename escaping for backslashes and newlines is supported.
* Filesystem advice is best-effort and never required for correctness.
* Output generation appends unless --truncate is supplied. As with ordinary
  separate output files, a crash cannot make the two manifest updates atomic.

Compatibility
-------------
Generated records use GNU checksum binary-mode syntax and can be checked by
sha256sum --check and sha512sum --check on Linux. The checker accepts GNU-style
SHA-256 and SHA-512 records, including text/binary markers and escaped names.
__HASH_SUITE_README_TXT_EOF__
chmod 755 "$DEST/hashfiles.py" "$DEST/hashcheck.py"
printf "Extracted utilities to %s\n" "$DEST"
