#!/bin/sh
# Self-extracting hashsuite archive. Usage: sh hashsuite.shar [destination]
set -eu
DEST=${1:-hashsuite}
mkdir -p "$DEST"
base64 -d > "$DEST/hashcore.py" <<'HASH_SUITE_HASHCORE_PY_EOF'

HASH_SUITE_HASHCORE_PY_EOF
base64 -d > "$DEST/hashfiles.py" <<'HASH_SUITE_HASHFILES_PY_EOF'

HASH_SUITE_HASHFILES_PY_EOF
base64 -d > "$DEST/hashcheck.py" <<'HASH_SUITE_HASHCHECK_PY_EOF'

HASH_SUITE_HASHCHECK_PY_EOF
base64 -d > "$DEST/README.txt" <<'HASH_SUITE_README_TXT_EOF'

HASH_SUITE_README_TXT_EOF
chmod +x "$DEST/hashcore.py" "$DEST/hashfiles.py" "$DEST/hashcheck.py"
ln -sf hashfiles.py "$DEST/sha256sum"
ln -sf hashfiles.py "$DEST/sha512sum"
echo "Extracted hashsuite to $DEST"
